<MembersScreen>:
    name: 'members'
    canvas.before:
        Color:
            rgba: 0.95, 0.96, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        # Header Bar
        BoxLayout:
            size_hint_y: None
            height: '50dp'
            canvas.before:
                Color:
                    rgba: 0.10, 0.21, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            padding: [15, 0]

            Label:
                text: "Members Directory & Onboarding"
                font_size: '18sp'
                bold: True
                color: 1, 1, 1, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Button:
                text: "Back to Dashboard"
                size_hint_x: None
                width: '150dp'
                background_color: 0.25, 0.35, 0.45, 1
                background_normal: ''
                on_release: root.manager.current = 'dashboard'

        # New Member Form Block
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: '180dp'
            padding: 10
            spacing: 10
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [8,]

            Label:
                text: "Register New Member"
                font_size: '16sp'
                bold: True
                color: 0.10, 0.21, 0.36, 1
                size_hint_y: None
                height: '25dp'

            GridLayout:
                cols: 3
                spacing: 10

                TextInput:
                    id: txt_passbook
                    hint_text: "Passbook # (Required)"
                    multiline: False

                TextInput:
                    id: txt_fullname
                    hint_text: "Full Name (Required)"
                    multiline: False

                TextInput:
                    id: txt_phone
                    hint_text: "Phone Number"
                    multiline: False

                TextInput:
                    id: txt_nok_name
                    hint_text: "Next of Kin Name"
                    multiline: False

                TextInput:
                    id: txt_nok_relation
                    hint_text: "Next of Kin Relation"
                    multiline: False

                TextInput:
                    id: txt_nok_phone
                    hint_text: "Next of Kin Phone"
                    multiline: False

        Button:
            text: "SAVE / REGISTER MEMBER"
            size_hint_y: None
            height: '40dp'
            bold: True
            background_color: 0.17, 0.56, 0.30, 1
            background_normal: ''
            on_release: root.register_or_update_member()

        # Registered Members List Area
        BoxLayout:
            orientation: 'vertical'
            padding: 10
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [8,]

            Label:
                text: "Registered Members List"
                font_size: '16sp'
                bold: True
                color: 0.10, 0.21, 0.36, 1
                size_hint_y: None
                height: '30dp'

            ScrollView:
                BoxLayout:
                    id: members_list_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 5