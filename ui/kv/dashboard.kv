<DashboardScreen>:
    name: 'dashboard'
    canvas.before:
        Color:
            rgba: 0.95, 0.96, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15

        # Top Header Bar
        BoxLayout:
            size_hint_y: None
            height: '60dp'
            canvas.before:
                Color:
                    rgba: 0.10, 0.21, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            padding: [20, 0]
            
            Label:
                text: "DIGISAVE - VSLA Automation System"
                font_size: '22sp'
                bold: True
                color: 1, 1, 1, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Label:
                id: cycle_label
                text: "Active Cycle: Loading..."
                font_size: '16sp'
                color: 0.8, 0.88, 1, 1
                halign: 'right'
                valign: 'middle'
                text_size: self.size

        # Summary Metric Cards
        BoxLayout:
            size_hint_y: None
            height: '110dp'
            spacing: 15

            BoxLayout:
                orientation: 'vertical'
                padding: 12
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8,]
                Label:
                    text: "Total Savings Pool"
                    font_size: '13sp'
                    color: 0.4, 0.45, 0.55, 1
                Label:
                    id: savings_pool_label
                    text: "UGX 0.00"
                    font_size: '18sp'
                    bold: True
                    color: 0.10, 0.21, 0.36, 1

            BoxLayout:
                orientation: 'vertical'
                padding: 12
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8,]
                Label:
                    text: "Welfare / Social Fund"
                    font_size: '13sp'
                    color: 0.4, 0.45, 0.55, 1
                Label:
                    id: welfare_pool_label
                    text: "UGX 0.00"
                    font_size: '18sp'
                    bold: True
                    color: 0.17, 0.56, 0.30, 1

            BoxLayout:
                orientation: 'vertical'
                padding: 12
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8,]
                Label:
                    text: "Active Loans Outstanding"
                    font_size: '13sp'
                    color: 0.4, 0.45, 0.55, 1
                Label:
                    id: active_loans_label
                    text: "UGX 0.00"
                    font_size: '18sp'
                    bold: True
                    color: 0.85, 0.30, 0.20, 1

        # Action Grid
        GridLayout:
            cols: 3
            spacing: 15
            padding: [5, 10]

            Button:
                text: "Start New Cycle"
                font_size: '16sp'
                bold: True
                background_color: 0.25, 0.35, 0.45, 1
                background_normal: ''
                on_release: root.manager.current = 'new_cycle'

            Button:
                text: "Continue Active Meeting"
                font_size: '16sp'
                bold: True
                background_color: 0.25, 0.35, 0.45, 1
                background_normal: ''
                on_release: root.manager.current = 'meeting'

            Button:
                text: "Manage Members Directory"
                font_size: '16sp'
                bold: True
                background_color: 0.25, 0.35, 0.45, 1
                background_normal: ''
                on_release: root.manager.current = 'members'

            Button:
                text: "Loan Portfolio & Repayments"
                font_size: '16sp'
                bold: True
                background_color: 0.25, 0.35, 0.45, 1
                background_normal: ''
                on_release: root.manager.current = 'meeting'

            Button:
                text: "Cycles Archive"
                font_size: '16sp'
                bold: True
                background_color: 0.25, 0.35, 0.45, 1
                background_normal: ''
                on_release: root.manager.current = 'archive'

            Button:
                text: "Reports & A4 PDF Exports"
                font_size: '16sp'
                bold: True
                background_color: 0.25, 0.35, 0.45, 1
                background_normal: ''
                on_release: root.manager.current = 'reports'