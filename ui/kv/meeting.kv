<MeetingScreen>:
    name: 'meeting'
    canvas.before:
        Color:
            rgba: 0.95, 0.96, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 12

        # Header Bar
        BoxLayout:
            size_hint_y: None
            height: '50dp'
            canvas.before:
                Color:
                    rgba: 0.10, 0.21, 0.36, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            padding: [15, 0]

            Label:
                id: meeting_header_label
                text: "7-Step Meeting Workflow & Ledger"
                font_size: '18sp'
                bold: True
                color: 1, 1, 1, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Button:
                text: "Dashboard"
                size_hint_x: None
                width: '120dp'
                background_color: 0.25, 0.35, 0.45, 1
                background_normal: ''
                on_release: root.manager.current = 'dashboard'

        # 7-Step Navigation Bar
        BoxLayout:
            size_hint_y: None
            height: '40dp'
            spacing: 3

            Button:
                id: step1_btn
                text: "1. Attendance"
                on_release: root.switch_step(1)
            Button:
                id: step2_btn
                text: "2. Fines"
                on_release: root.switch_step(2)
            Button:
                id: step3_btn
                text: "3. Savings"
                on_release: root.switch_step(3)
            Button:
                id: step4_btn
                text: "4. Welfare"
                on_release: root.switch_step(4)
            Button:
                id: step5_btn
                text: "5. Loans Out"
                on_release: root.switch_step(5)
            Button:
                id: step6_btn
                text: "6. Repayments"
                on_release: root.switch_step(6)
            Button:
                id: step7_btn
                text: "7. Summary"
                on_release: root.switch_step(7)

        # Dynamic Content Area for Each Step
        BoxLayout:
            id: step_content_container
            orientation: 'vertical'
            padding: 10
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [8,]